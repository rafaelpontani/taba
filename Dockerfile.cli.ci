# syntax=docker/dockerfile:1
#
# The taba-cli image used by the pipeline (.github/workflows). It compiles nothing: the static binary
# already comes ready in dist/taba-cli-<arch>, produced by the Rust connector job. buildx (amd64 and
# arm64 platforms) picks the file by TARGETARCH.
#
# Usage: `docker run --rm rafaelpontani/taba-cli --help`. No need to install taba-cli on the machine.

FROM alpine:3
ARG TARGETARCH
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 taba
COPY dist/taba-cli-${TARGETARCH} /usr/local/bin/taba-cli
USER taba
ENTRYPOINT ["taba-cli"]

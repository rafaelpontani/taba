# Cross-language, step 2 (every connector): publishes a text with accents, a JSON and bytes to the distributor, so
# each connector's queue receives what every other connector sent.
publishText topic={p}-in body=text-from-{lang} => matched=8
publishText topic={p}-in body=caf%C3%A9-%E2%82%AC-{lang} => matched=8
publishJson topic={p}-in body={"from":"{lang}"} => matched=8
publishBytes topic={p}-in base64=AAEC/w== => matched=8

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# driver of the connector contract tests (connectors/contract/README.md): reads the scenario files and runs
       each line against a real Taba. Not a package and not a test project: contract/run.sh and
       connectors/contract/run.sh run it. net8.0, the SDK the connector builds with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>Taba.Contract</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taba.Client\Taba.Client.csproj" />
  </ItemGroup>

</Project>

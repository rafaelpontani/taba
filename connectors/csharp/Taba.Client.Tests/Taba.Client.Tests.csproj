<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# connector tests (NUnit 3): the unit ones, no network, and the integration ones, against a real Taba
       (category "Integration"; they only run with TABA_URL, see scripts/integration.sh).
       They run on .NET 6, 8 and 10 (10 with SDK 10), each against the connector target of the same version. -->
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>Taba.Tests</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taba.Client\Taba.Client.csproj" />
    <ProjectReference Include="..\Taba.Client.Extensions.DependencyInjection\Taba.Client.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

</Project>

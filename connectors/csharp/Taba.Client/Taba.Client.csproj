<Project Sdk="Microsoft.NET.Sdk">

  <!-- O conector C# do Taba (doc/19a-conectores-linguagens.md, "C#"). Um só código para o .NET clássico
       (net461, o Framework 4.6.1 a 4.8) e o moderno (net5.0 em diante), em C# 7.3 nos dois, sem
       dependências além da biblioteca-padrão. -->
  <PropertyGroup>
    <TargetFrameworks>net461;net5.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Taba.Client</AssemblyName>
    <RootNamespace>Taba</RootNamespace>
    <PackageId>Taba.Client</PackageId>
    <Version>0.1.0</Version>
    <Description>Conector C# do Taba, a fila de mensagens em cluster.</Description>
    <Authors>Taba</Authors>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- O SDK avisa que o .NET 5 saiu de suporte; ele é o piso da linha moderna (doc 19a). -->
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- O net10.0 só existe a partir do SDK 10; com o SDK 8 o conector compila os outros cinco alvos. -->
  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- No net461, o HttpClient vem do assembly System.Net.Http do Framework. Os reference assemblies
       deixam um SDK em qualquer sistema (Linux, macOS) compilar o alvo clássico. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taba.Client.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Taba C# connector (doc/19a-conectores-linguagens.md, "C#"). A single codebase for classic .NET
       (net461, Framework 4.6.1 to 4.8) and modern (net5.0 and later), in C# 7.3 on both, with no
       dependencies beyond the standard library. -->
  <PropertyGroup>
    <TargetFrameworks>net461;net5.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Taba.Client</AssemblyName>
    <RootNamespace>Taba</RootNamespace>
    <PackageId>Taba.Client</PackageId>
    <Version>0.1.0</Version>
    <Description>Taba C# connector, the clustered message queue.</Description>
    <Authors>Taba</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The SDK warns that .NET 5 is out of support; it is the floor of the modern line (doc 19a). -->
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- net10.0 only exists from SDK 10 on; with SDK 8 the connector builds the other five targets. -->
  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- On net461, HttpClient comes from the Framework's System.Net.Http assembly. The reference assemblies
       let an SDK on any system (Linux, macOS) build the classic target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The contracts (ITabaClient, the models and the TabaException) live in Taba.Client.Abstractions. -->
  <ItemGroup>
    <ProjectReference Include="..\Taba.Client.Abstractions\Taba.Client.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taba.Client.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contracts of the Taba C# connector: the ITabaClient interface, the models (topic, message,
       options, responses) and the TabaException. Whoever only needs to type or mock the client (dependency
       injection, tests) references this package, without the HttpClient or the JSON reader of
       Taba.Client. Same targets and C# 7.3 as the connector, no dependencies. -->
  <PropertyGroup>
    <TargetFrameworks>net461;net5.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Taba.Client.Abstractions</AssemblyName>
    <RootNamespace>Taba</RootNamespace>
    <PackageId>Taba.Client.Abstractions</PackageId>
    <Version>0.1.0</Version>
    <Description>Interfaces and models of the Taba C# connector, the clustered message queue.</Description>
    <Authors>Taba</Authors>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The constructor and the internal setters of the models belong to Taba.Client, which fills them when reading the JSON. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Taba.Client" />
    <InternalsVisibleTo Include="Taba.Client.Tests" />
  </ItemGroup>

</Project>

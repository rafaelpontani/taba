<Project Sdk="Microsoft.NET.Sdk">

  <!-- The integration of the Taba C# connector with Microsoft.Extensions.DependencyInjection and IOptions:
       AddTabaClient registers the ITabaClient, reading the TabaConfig from the options (code or appsettings.json).
       It lives in a separate package so Taba.Client stays dependency-free. -->
  <PropertyGroup>
    <TargetFrameworks>net461;net5.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Taba.Client.Extensions.DependencyInjection</AssemblyName>
    <RootNamespace>Microsoft.Extensions.DependencyInjection</RootNamespace>
    <PackageId>Taba.Client.Extensions.DependencyInjection</PackageId>
    <Version>0.1.0</Version>
    <Description>AddTabaClient (DI and IOptions) for the Taba C# connector.</Description>
    <Authors>Taba</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taba.Client\Taba.Client.csproj" />
  </ItemGroup>

</Project>

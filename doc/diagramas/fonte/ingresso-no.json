    },
    {
      "id": "tabela",
      "from": "contato",
      "to": "novo",
      "y": 384,
      "label": "tabela de nós e nós em freezing",
      "variant": "return"
    },
    {
      "id": "topicos",
      "from": "novo",
      "to": "demais",
      "y": 420,
      "label": "abre canal e puxa tópicos (stream)",
      "variant": "dashed",
      "note": "origem: nó de menor carga"
    },
    {
      "id": "ids",
      "from": "novo",
      "to": "resp",
      "y": 448,
      "label": "stream de IDs do bloco (união)"
    },
    {
      "id": "get",
      "from": "novo",
      "to": "resp",
      "y": 476,
      "label": "GET por faixa (distribuído)",
      "variant": "emphasis"
    },
    {
      "id": "get-ok",
      "from": "resp",
      "to": "novo",
      "y": 504,
      "label": "mensagens (NDJSON) direto no disco",
      "variant": "return"
    },
    {
      "id": "final",
      "from": "novo",
      "to": "resp",
      "y": 532,
      "label": "verificação final: relista IDs",
      "variant": "dashed",
      "note": "depois processa o banco de eventos e fica pronto"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Falha antes do commit",
      "items": [
        "Rollback do registro e o novo nó é excluído",
        "Conflito com outra mudança: a perdedora recomeça em 100 a 200 ms",
        "Blocos são rebalanceados sem ele"
      ]
    },
    {
      "dot": "orange",
      "title": "Falha no commit",
      "items": [
        "Sem rollback: insiste até write.commit.timeout"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durante a sincronização",
      "items": [
        "Eventos que chegam vão para o banco de eventos (SQLite)",
        "Ao fim, processados linha a linha; esvazia e o nó fica pronto",
        "Até lá, chamadas de cliente são repassadas a outro nó"
      ]
    }
  ]
}

      "sublabel": "via balanceador; coordena"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Demais nós",
      "sublabel": "todos os membros"
    },
    {
      "id": "resp",
      "type": "database",
      "label": "Nós do bloco",
      "sublabel": "primário e réplicas"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 214,
      "label": "Descoberta"
    },
    {
      "from": 222,
      "to": 278,
      "label": "Teste de conexão"
    },
    {
      "from": 286,
      "to": 398,
      "label": "Registro e commit em todos"
    },
    {
      "from": 406,
      "to": 546,
      "label": "Sincronização e prontidão"
    }
  ],
  "messages": [
    {
      "id": "lista",
      "from": "novo",
      "to": "contato",
      "y": 172,
      "label": "GET /cluster/nodes (balanceador)",
      "variant": "dashed",
      "note": "cluster.entry-address"
    },
    {
      "id": "lista-ok",
      "from": "contato",
      "to": "novo",
      "y": 200,
      "label": "tabela de membros (IPs internos)",

    },
    {
      "id": "reg",
      "from": "contato",
      "to": "demais",
      "y": 300,
      "label": "registro (fase 1)",
      "note": "em conflito, a mudança mais antiga vence"
    },
    {
      "id": "reg-ok",
      "from": "demais",
      "to": "contato",
      "y": 328,
      "label": "todos confirmam",
      "variant": "return"
    },
    {
      "id": "com",
      "from": "contato",
      "to": "demais",
      "y": 356,
      "label": "commit (fase 2), confirmado por todos",

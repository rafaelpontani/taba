{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Ingresso de um novo nó no cluster",
    "output": "doc/diagramas/html/ingresso-no.html",
    "viewBox": [
      1080,
      696
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "novo",
      "type": "backend",
      "label": "Novo nó",
      "sublabel": "bootstrap"
    },
    {
      "id": "contato",
      "type": "security",
      "label": "Nó de contato",
      "sublabel": "coordena o registro"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Demais nós",
      "sublabel": "todos os membros"
    },
    {
      "id": "resp",
      "type": "database",
      "label": "Nós do bloco",
      "sublabel": "primário e réplicas"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 214,
      "label": "Teste de conexão"
    },
    {
      "from": 222,
      "to": 362,
      "label": "Registro e commit em todos"
    },
    {
      "from": 370,
      "to": 566,
      "label": "Sincronização do bloco"
    }
  ],
  "messages": [
    {
      "id": "boot",
      "from": "novo",
      "to": "contato",
      "y": 172,
      "label": "registro: IPs e porta",
      "variant": "emphasis"
    },
    {
      "id": "teste",
      "from": "contato",
      "to": "novo",
      "y": 200,
      "label": "testa conexão de volta",
      "note": "se falhar, aborta"
    },
    {
      "id": "reg",
      "from": "contato",
      "to": "demais",
      "y": 236,
      "label": "registro (fase 1)"
    },
    {
      "id": "reg-ok",
      "from": "demais",
      "to": "contato",
      "y": 264,
      "label": "todos confirmam",
      "variant": "return"
    },
    {
      "id": "com",
      "from": "contato",
      "to": "demais",
      "y": 292,
      "label": "commit (fase 2)",
      "variant": "emphasis"
    },
    {
      "id": "com-ok",
      "from": "demais",
      "to": "contato",
      "y": 320,
      "label": "ok",
      "variant": "return"
    },
    {
      "id": "tabela",
      "from": "contato",
      "to": "novo",
      "y": 348,
      "label": "tabela de nós",
      "variant": "return"
    },
    {
      "id": "topicos",
      "from": "novo",
      "to": "demais",
      "y": 384,
      "label": "puxa tabela de tópicos (stream)",
      "variant": "dashed"
    },
    {
      "id": "canal",
      "from": "novo",
      "to": "demais",
      "y": 412,
      "label": "abre canal WebSocket",
      "variant": "dashed",
      "note": "assume posição no anel"
    },
    {
      "id": "ids",
      "from": "novo",
      "to": "resp",
      "y": 440,
      "label": "stream de IDs do bloco"
    },
    {
      "id": "ids-ok",
      "from": "resp",
      "to": "novo",
      "y": 468,
      "label": "IDs (união das listas)",
      "variant": "return"
    },
    {
      "id": "get",
      "from": "novo",
      "to": "resp",
      "y": 496,
      "label": "GET por faixa (distribuído)",
      "variant": "emphasis"
    },
    {
      "id": "get-ok",
      "from": "resp",
      "to": "novo",
      "y": 524,
      "label": "mensagens (NDJSON)",
      "variant": "return"
    },
    {
      "id": "final",
      "from": "novo",
      "to": "resp",
      "y": 552,
      "label": "verificação final: relista IDs",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Falha antes do commit",
      "items": [
        "Rollback do registro e o novo nó é excluído",
        "Blocos são rebalanceados sem ele"
      ]
    },
    {
      "dot": "orange",
      "title": "Falha no commit",
      "items": [
        "Sem rollback: insiste até write.commit.timeout"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durante a sincronização",
      "items": [
        "Recebe novas mensagens, mas não entrega o bloco",
        "Deleções ficam em log e são aplicadas ao fim"
      ]
    }
  ]
}

{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "States of a node",
    "output": "doc/diagramas/html/estados-no.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Join"
    },
    {
      "id": "recovery",
      "label": "Return"
    },
    {
      "id": "terminal",
      "label": "Failure"
    }
  ],
  "states": [
    {
      "id": "joining",
      "type": "start",
      "label": "joining",
      "sublabel": "asked to join",
      "lane": "main",
      "col": 0
    },
    {
      "id": "syncing",
      "type": "active",
      "label": "syncing",
      "sublabel": "in the table, not serving",
      "lane": "main",
      "col": 1
    },
    {
      "id": "active",
      "type": "success",
      "label": "active",
      "sublabel": "serves clients",
      "lane": "main",
      "col": 2
    },
    {
      "id": "returning",
      "type": "waiting",
      "label": "returning",
      "sublabel": "recovers messages",
      "lane": "recovery",
      "col": 2
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "failed",
      "sublabel": "fatal disk error",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "from": "joining",
      "to": "syncing",
      "label": "join commit"
    },
    {
      "from": "syncing",
      "to": "active",
      "label": "synchronization ready"
    },
    {
      "from": "active",
      "to": "returning",
      "label": "excluded or drain"
    },
    {
      "from": "returning",
      "to": "joining",
      "label": "redoes the join",
      "variant": "dashed"
    },
    {
      "from": "active",
      "to": "failed",
      "label": "disk error",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "State and drain",
      "items": [
        "drainState is separate: active → draining → drained",
        "Freezing is not a state: it is a property of an excluded member"
      ]
    },
    {
      "dot": "rose",
      "title": "failed",
      "items": [
        "Only restarting the process fixes it",
        "The restart is born as a new node"
      ]
    }
  ]
}

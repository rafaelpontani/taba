{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Message consumption (delivery and ack)",
    "output": "doc/diagramas/html/consumo.html",
    "viewBox": [
      1080,
      658
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "consumidor",
      "type": "external",
      "label": "Consumer",
      "sublabel": "HTTP client"
    },
    {
      "id": "no",
      "type": "backend",
      "label": "Coordinator node",
      "sublabel": "delivery owner on the GET"
    },
    {
      "id": "replica",
      "type": "database",
      "label": "Replica (quorum)",
      "sublabel": "confirms with the owner"
    },
    {
      "id": "fora",
      "type": "cloud",
      "label": "Replica out",
      "sublabel": "outside the quorum"
    }
  ],
  "segments": [
    {
      "from": 156,
      "to": 352,
      "label": "Delivery (GET)"
    },
    {
      "from": 360,
      "to": 528,
      "label": "Confirmation (ack)"
    }
  ],
  "messages": [
    {
      "id": "get",
      "from": "consumidor",
      "to": "no",
      "y": 170,
      "label": "GET .../messages?maxMessages=10",
      "variant": "emphasis",
      "note": "picks an ID from the ready list"
    },
    {
      "id": "reg-r",
      "from": "no",
      "to": "replica",
      "y": 198,
      "label": "register: invisible until T, count+1, token"
    },
    {
      "id": "reg-f",
      "from": "no",
      "to": "fora",
      "y": 226,
      "label": "register: invisible until T"
    },
    {
      "id": "ok-r",
      "from": "replica",
      "to": "no",
      "y": 254,
      "label": "confirms: quorum closed",
      "variant": "return"
    },
    {
      "id": "com-r",
      "from": "no",
      "to": "replica",
      "y": 282,
      "label": "commit",
      "variant": "emphasis",
      "note": "removes the ID from the ready list"
    },
    {
      "id": "resp-get",
      "from": "no",
      "to": "consumidor",
      "y": 310,
      "label": "200 messages + receiptToken",
      "variant": "return"
    },
    {
      "id": "com-f",
      "from": "no",
      "to": "fora",
      "y": 338,
      "label": "commit (background)",
      "variant": "dashed"
    },
    {
      "id": "ack",
      "from": "consumidor",
      "to": "no",
      "y": 374,
      "label": "DELETE .../{id}?receiptToken",
      "variant": "emphasis",
      "note": "before invisibleUntil expires"
    },
    {
      "id": "ack-reg",
      "from": "no",
      "to": "replica",
      "y": 402,
      "label": "removal register"
    },
    {
      "id": "ack-ok",
      "from": "replica",
      "to": "no",
      "y": 430,
      "label": "confirms: quorum closed",
      "variant": "return"
    },
    {
      "id": "ack-com",
      "from": "no",
      "to": "replica",
      "y": 458,
      "label": "commit: deletes the message",
      "variant": "emphasis"
    },
    {
      "id": "ack-resp",
      "from": "no",
      "to": "consumidor",
      "y": 486,
      "label": "204 no content",
      "variant": "return"
    },
    {
      "id": "ack-bg",
      "from": "no",
      "to": "fora",
      "y": 514,
      "label": "removal (background)",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "At-least-once",
      "items": [
        "Without an ack, invisibleUntil expires and the message goes back to the ready list",
        "deliveryCount goes up on each delivery"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local list not complete",
      "items": [
        "Completes with other nodes (internal take route) up to maxMessages",
        "With none, becomes a local listener up to waitTime (0 to 20 s)"
      ]
    },
    {
      "dot": "rose",
      "title": "Failures",
      "items": [
        "Before the quorum: rollback, message stays available",
        "After the quorum: no rollback, insists in the background"
      ]
    }
  ]
}

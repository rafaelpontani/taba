{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Scenario 1: the local list has a message",
    "output": "doc/diagramas/html/consumo-cenario1-lista-local.html",
    "viewBox": [
      1080,
      486
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "consumidor",
      "type": "external",
      "label": "Consumer",
      "sublabel": "HTTP client"
    },
    {
      "id": "a",
      "type": "backend",
      "label": "Node A",
      "sublabel": "primary of m1"
    },
    {
      "id": "quorum",
      "type": "database",
      "label": "Replicas (quorum)",
      "sublabel": "B or C, with the primary"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "y": 176,
      "from": "consumidor",
      "to": "a",
      "label": "GET /topics/orders/messages",
      "variant": "emphasis",
      "note": "A's ready list: [m1, m4]"
    },
    {
      "id": "m2",
      "y": 214,
      "from": "a",
      "to": "quorum",
      "label": "register: invisible until T, count+1"
    },
    {
      "id": "m3",
      "y": 252,
      "from": "quorum",
      "to": "a",
      "label": "confirms: quorum closed",
      "variant": "return"
    },
    {
      "id": "m4",
      "y": 290,
      "from": "a",
      "to": "quorum",
      "label": "commit",
      "variant": "emphasis",
      "note": "A removes m1 from the ready list"
    },
    {
      "id": "m5",
      "y": 328,
      "from": "quorum",
      "to": "a",
      "label": "ok",
      "variant": "return"
    },
    {
      "id": "m6",
      "y": 366,
      "from": "a",
      "to": "consumidor",
      "label": "200 m1 + receiptToken",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Common case",
      "items": [
        "A is the owner of m1, so it decides alone",
        "No other node is queried to find the message"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cost",
      "items": [
        "Only the register and the commit on the quorum, as in any delivery"
      ]
    }
  ]
}

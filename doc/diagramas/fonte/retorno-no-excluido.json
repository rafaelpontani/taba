    },
    {
      "id": "donos",
      "type": "database",
      "label": "Novos donos",
      "sublabel": "outros nós e donos dos blocos"
    },
    {
      "id": "contato",
      "type": "security",
      "label": "Nó de contato",
      "sublabel": "coordena o registro"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 242,
      "label": "Recuperação de mensagens"
    },
    {
      "from": 250,
      "to": 334,
      "label": "Novo bootstrap"
    }
  ],
  "messages": [
    {
      "id": "envia",
      "from": "volta",
      "to": "donos",
      "y": 172,
      "label": "GET /cluster/message-loss (todos os nós)",
      "variant": "emphasis",
      "note": "une as listas de perdas"
    },
    {
      "id": "envia-ok",
      "from": "donos",
      "to": "volta",
      "y": 200,
      "label": "pares (tópico, ID) perdidos",
      "variant": "return"
    },
    {
      "id": "envia-com",
      "from": "volta",
      "to": "donos",
      "y": 228,
      "label": "POST /recover: mensagens que o nó achou",
      "variant": "emphasis",
      "note": "confronta com disco e memória"
    },
    {
      "id": "boot",
      "from": "volta",
      "to": "contato",
      "y": 264,
      "label": "registro: IPs e porta",
      "variant": "emphasis",
      "note": "limpa estado local e recomeça do zero"
    },
    {
      "id": "ingresso",
      "from": "contato",
      "to": "donos",
      "y": 292,
      "label": "registro e commit em todos (seção 6.2)"
    },
    {
      "id": "tabela",
      "from": "contato",
      "to": "volta",
      "y": 320,
      "label": "tabela de nós e de tópicos",
      "variant": "return",
      "note": "nova posição no anel"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Sem mensagens perdidas",
      "items": [
        "Nada a enviar: limpa o estado e refaz o bootstrap",
        "Dados antigos ficam em quarentena até a recuperação acabar"
      ]
    },
    {
      "dot": "rose",
      "title": "Freezing opcional",
      "items": [
        "Pode atrasar o novo registro até o período expirar",
        "A recuperação das mensagens não depende dele"
      ]
    },
    {
      "dot": "emerald",
      "title": "Não retoma o lugar antigo",
      "items": [
        "Os blocos dele já foram reatribuídos a outros nós"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Return of an excluded node",
    "output": "doc/diagramas/html/retorno-no-excluido.html",
    "viewBox": [
      1080,
      480
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "volta",
      "type": "external",
      "label": "Node that came back",
      "sublabel": "excluded by failure"
    },
    {
      "id": "donos",
      "type": "database",
      "label": "New owners",
      "sublabel": "other nodes and block owners"
    },
    {
      "id": "contato",
      "type": "security",
      "label": "Contact node",
      "sublabel": "coordinates the register"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 242,
      "label": "Message recovery"
    },
    {
      "from": 250,
      "to": 334,
      "label": "New bootstrap"
    }
  ],
  "messages": [
    {
      "id": "envia",
      "from": "volta",
      "to": "donos",
      "y": 172,
      "label": "GET /cluster/message-loss (all nodes)",
      "variant": "emphasis",
      "note": "merges the loss lists"
    },
    {
      "id": "envia-ok",
      "from": "donos",
      "to": "volta",
      "y": 200,
      "label": "lost (topic, ID) pairs",
      "variant": "return"
    },
    {
      "id": "envia-com",
      "from": "volta",
      "to": "donos",
      "y": 228,
      "label": "POST /recover: messages the node found",
      "variant": "emphasis",
      "note": "checks against disk and memory"
    },
    {
      "id": "boot",
      "from": "volta",
      "to": "contato",
      "y": 264,
      "label": "register: IPs and port",
      "variant": "emphasis",
      "note": "clears local state and starts over"
    },
    {
      "id": "ingresso",
      "from": "contato",
      "to": "donos",
      "y": 292,
      "label": "register and commit on all"
    },
    {
      "id": "tabela",
      "from": "contato",
      "to": "volta",
      "y": 320,
      "label": "node and topic table",
      "variant": "return",
      "note": "new position on the ring"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "No lost messages",
      "items": [
        "Nothing to send: clears the state and redoes the bootstrap",
        "Old data stays in quarantine until the recovery ends"
      ]
    },
    {
      "dot": "rose",
      "title": "Optional freezing",
      "items": [
        "May delay the new registration until the period expires",
        "The message recovery does not depend on it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Does not resume the old place",
      "items": [
        "Its blocks have already been reassigned to other nodes"
      ]
    }
  ]
}

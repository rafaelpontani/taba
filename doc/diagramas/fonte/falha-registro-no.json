{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Failure in a new node's registration",
    "output": "doc/diagramas/html/falha-registro-no.html",
    "viewBox": [
      1080,
      528
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "novo",
      "type": "backend",
      "label": "New node",
      "sublabel": "bootstrap"
    },
    {
      "id": "contato",
      "type": "security",
      "label": "Contact node",
      "sublabel": "coordinates the register"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Other nodes",
      "sublabel": "all the members"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 214,
      "label": "Failure in the test"
    },
    {
      "from": 222,
      "to": 306,
      "label": "Failure in the register phase"
    },
    {
      "from": 314,
      "to": 398,
      "label": "Exclusion"
    }
  ],
  "messages": [
    {
      "id": "boot",
      "from": "novo",
      "to": "contato",
      "y": 172,
      "label": "register: IPs and port",
      "variant": "emphasis"
    },
    {
      "id": "teste",
      "from": "contato",
      "to": "novo",
      "y": 200,
      "label": "tests connection back: fails",
      "variant": "security"
    },
    {
      "id": "reg",
      "from": "contato",
      "to": "demais",
      "y": 236,
      "label": "register (phase 1)"
    },
    {
      "id": "reg-falha",
      "from": "demais",
      "to": "contato",
      "y": 264,
      "label": "not all confirm (write.commit.timeout)",
      "variant": "return"
    },
    {
      "id": "rollback",
      "from": "contato",
      "to": "demais",
      "y": 292,
      "label": "rollback of the pending register",
      "variant": "security"
    },
    {
      "id": "excluido",
      "from": "contato",
      "to": "novo",
      "y": 328,
      "label": "register refused: node excluded",
      "variant": "return",
      "note": "never enters the member table"
    },
    {
      "id": "rebalanceia",
      "from": "contato",
      "to": "demais",
      "y": 356,
      "label": "ring recalculated without the new node",
      "variant": "emphasis"
    },
    {
      "id": "retry",
      "from": "novo",
      "to": "contato",
      "y": 384,
      "label": "new bootstrap attempt",
      "variant": "dashed",
      "note": "retry and backoff to be defined"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Before the commit",
      "items": [
        "Connection test or phase 1 without all the confirmations",
        "Aborts with rollback of the pending register"
      ]
    },
    {
      "dot": "orange",
      "title": "After phase 1",
      "items": [
        "Not a register failure: no rollback",
        "Coordinator insists on the commit until write.commit.timeout"
      ]
    },
    {
      "dot": "emerald",
      "title": "Effect",
      "items": [
        "Blocks rebalanced among the remaining nodes"
      ]
    }
  ]
}

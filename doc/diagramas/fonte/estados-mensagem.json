{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": { "title": "Estados de uma mensagem no dono da entrega", "output": "doc/diagramas/html/estados-mensagem.html", "quality_profile": "showcase" },
  "lanes": [
    { "id": "main", "label": "Entrega" },
    { "id": "terminal", "label": "Fim" }
  ],
  "states": [
    { "id": "ready", "type": "start", "label": "Pronta", "sublabel": "na lista de prontos", "lane": "main", "col": 0 },
    { "id": "invisible", "type": "waiting", "label": "Invisível", "sublabel": "invisibleUntil no futuro", "lane": "main", "col": 2 },
    { "id": "removed", "type": "success", "label": "Removida", "sublabel": "mensagem e metadados apagados", "lane": "terminal", "col": 3 },
    { "id": "dead", "type": "failure", "label": "Dead-letter", "sublabel": "limite de entregas", "lane": "terminal", "col": 1 }
  ],
  "transitions": [
    { "from": "ready", "to": "invisible", "label": "GET: entrega" },
    { "from": "invisible", "to": "ready", "label": "prazo vencido ou visibilityTimeout 0", "variant": "dashed" },
    { "from": "invisible", "to": "removed", "label": "ack", "variant": "emphasis" },
    { "from": "invisible", "to": "dead", "label": "maxDeliveries esgotado", "variant": "security" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Pelo menos uma vez", "items": ["Sem ack no prazo, a mensagem volta a ser pronta", "Cada entrega nova troca o receiptToken"] },
    { "dot": "amber", "title": "Propagação", "items": ["Entrega e ack são registro + commit no quórum com o primário"] }
  ]
}

    },
    {
      "id": "reg",
      "from": "dono",
      "to": "replicas",
      "y": 200,
      "label": "registro: invisibleUntil, token, entrega + 1"
    },
    {
      "id": "reg-ok",
      "from": "replicas",
      "to": "dono",
      "y": 228,
      "label": "quórum confirma",
      "variant": "return"
    },
    {
      "id": "com",
      "from": "dono",

      "variant": "dashed"
    },
    {
      "id": "msg",
      "from": "dono",
      "to": "cliente",
      "y": 312,
      "label": "mensagem entregue",
      "variant": "return"
    },
    {
      "id": "cheia",
      "from": "dono",
      "to": "disco",
      "y": 348,
      "label": "lista cheia: grava o de prazo mais distante",
      "variant": "security"
    },
    {
      "id": "repoe",
      "from": "dono",
      "to": "prontos",
      "y": 384,
      "label": "prazo vence sem ack: ID volta à lista",
      "variant": "emphasis",
      "note": "sem tráfego entre nós"
    },
    {
      "id": "janela",
      "from": "dono",
      "to": "disco",
      "y": 412,
      "label": "lista esvazia: lê os próximos a vencer",
      "variant": "dashed"
    },
    {
      "id": "janela-ok",
      "from": "disco",
      "to": "dono",
      "y": 440,
      "label": "IDs e prazos",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Ack ou PATCH",
      "items": [
        "Registro + commit no quórum, exigem o receiptToken",
        "PATCH define o novo prazo a partir de agora; 0 libera"
      ]
    },
    {
      "dot": "rose",
      "title": "Expiração não se propaga",
      "items": [
        "Prazo no passado nos metadados já significa visível",
        "A próxima entrega grava o novo prazo"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tabela é derivada",
      "items": [
        "A fonte de verdade são os metadados",
        "Ack, PATCH e entrega atualizam a linha na hora"
      ]
    }
  ]
}

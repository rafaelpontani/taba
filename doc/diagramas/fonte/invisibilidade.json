      "label": "Lista de prontos",
      "sublabel": "memória do dono"
    },
    {
      "id": "disco",
      "type": "database",
      "label": "Tabela de expiração",
      "sublabel": "SQLite local, excedente"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 326,
      "label": "Entrega e propagação"
    },
    {
      "from": 334,
      "to": 362,
      "label": "Excedente em disco"
    },
    {
      "from": 370,
      "to": 454,
      "label": "Expiração"
    }
  ],
  "messages": [
    {
      "id": "get",
      "from": "cliente",
      "to": "dono",
      "y": 172,
      "label": "GET (visibilityTimeout)",

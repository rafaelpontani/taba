{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Restart of a node's process",
    "output": "doc/diagramas/html/reinicio-processo.html",
    "viewBox": [
      1080,
      600
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "novo",
      "type": "backend",
      "label": "Restarted process",
      "sublabel": "new ID, previous life's disk"
    },
    {
      "id": "contato",
      "type": "security",
      "label": "Contact node",
      "sublabel": "coordinates the register"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Other nodes",
      "sublabel": "members and block owners"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 330,
      "label": "Join, without waiting for anyone"
    },
    {
      "from": 342,
      "to": 502,
      "label": "Recovery in the background"
    }
  ],
  "messages": [
    {
      "id": "lista",
      "from": "novo",
      "to": "contato",
      "y": 172,
      "label": "GET /cluster/nodes (load balancer)",
      "variant": "dashed",
      "note": "puts the old disk in _previous-life"
    },
    {
      "id": "lista-ok",
      "from": "contato",
      "to": "novo",
      "y": 200,
      "label": "member table",
      "variant": "return",
      "note": "the node goes on with an empty disk"
    },
    {
      "id": "boot",
      "from": "novo",
      "to": "contato",
      "y": 236,
      "label": "join request: IPs and port",
      "variant": "emphasis",
      "note": "new node, without freezing"
    },
    {
      "id": "ingresso",
      "from": "contato",
      "to": "demais",
      "y": 264,
      "label": "register and commit on all"
    },
    {
      "id": "tabela",
      "from": "contato",
      "to": "novo",
      "y": 292,
      "label": "node table",
      "variant": "return"
    },
    {
      "id": "ativo",
      "from": "novo",
      "to": "demais",
      "y": 320,
      "label": "syncs and becomes active",
      "variant": "dashed",
      "note": "does not stay in returning"
    },
    {
      "id": "perdas",
      "from": "novo",
      "to": "demais",
      "y": 372,
      "label": "GET /cluster/message-loss",
      "variant": "emphasis",
      "note": "to each node of the first listing"
    },
    {
      "id": "perdas-ok",
      "from": "demais",
      "to": "novo",
      "y": 400,
      "label": "lost (topic, ID) pairs",
      "variant": "return"
    },
    {
      "id": "recupera",
      "from": "novo",
      "to": "demais",
      "y": 436,
      "label": "POST /recover: what the old disk has",
      "variant": "emphasis",
      "note": "right away, for each list that arrives"
    },
    {
      "id": "mudo",
      "from": "novo",
      "to": "demais",
      "y": 472,
      "label": "repeats only the node that did not answer",
      "variant": "dashed",
      "note": "until cluster.recovery.timeout"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Previous life's disk",
      "items": [
        "Stays in _previous-life until the recovery ends",
        "After it, or at the deadline, the folder is deleted"
      ]
    },
    {
      "dot": "rose",
      "title": "Fall in the middle",
      "items": [
        "The old folder keeps counting",
        "The new one of the same topic is deleted"
      ]
    },
    {
      "dot": "emerald",
      "title": "First node of a new cluster",
      "items": [
        "There is no one to recover from: the old disk is deleted"
      ]
    }
  ]
}

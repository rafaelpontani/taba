{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Exclusão de uma fila volátil pelo gestor",
    "output": "doc/diagramas/html/fila-volatil-exclusao.html",
    "viewBox": [
      1080,
      500
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "cons",
      "type": "external",
      "label": "Consumidor",
      "sublabel": "cliente"
    },
    {
      "id": "gestor",
      "type": "backend",
      "label": "Nó gestor",
      "sublabel": "hash do id no anel"
    },
    {
      "id": "nos",
      "type": "cloud",
      "label": "Todos os nós",
      "sublabel": "último GET por tópico"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 186,
      "label": "Espera"
    },
    {
      "from": 194,
      "to": 250,
      "label": "Verificação final"
    },
    {
      "from": 258,
      "to": 370,
      "label": "Exclusão"
    }
  ],
  "messages": [
    {
      "id": "get",
      "from": "cons",
      "to": "nos",
      "y": 172,
      "label": "qualquer GET da fila",
      "variant": "dashed",
      "note": "o nó grava o instante no início"
    },
    {
      "id": "venc",
      "from": "gestor",
      "to": "nos",
      "y": 208,
      "label": "prazo vencido: há quanto foi o último GET?",
      "variant": "security",
      "note": "leitura local em cada nó"
    },
    {
      "id": "dur",
      "from": "nos",
      "to": "gestor",
      "y": 236,
      "label": "duração desde o último GET, por nó",
      "variant": "return",
      "note": "nenhum GET dentro do idleTimeout"
    },
    {
      "id": "reg",
      "from": "gestor",
      "to": "nos",
      "y": 272,
      "label": "exclusão (fase 1) com o id do tópico"
    },
    {
      "id": "ok",
      "from": "nos",
      "to": "gestor",
      "y": 300,
      "label": "todos confirmam, se o id confere",
      "variant": "return"
    },
    {
      "id": "com",
      "from": "gestor",
      "to": "nos",
      "y": 328,
      "label": "commit (fase 2)",
      "variant": "emphasis",
      "note": "apagam mensagens e definição"
    },
    {
      "id": "fim",
      "from": "nos",
      "to": "gestor",
      "y": 356,
      "label": "fila removida",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "GET recente",
      "items": [
        "Algum nó viu GET dentro do prazo",
        "O gestor reagenda pelo tempo restante"
      ]
    },
    {
      "dot": "rose",
      "title": "Na dúvida, não exclui",
      "items": [
        "Nó sem resposta: tenta de novo depois",
        "Nó recém-iniciado responde o tempo desde que subiu"
      ]
    },
    {
      "dot": "orange",
      "title": "Corrida residual",
      "items": [
        "GET entre a verificação e o commit recebe 404",
        "Com autoCreate, recria com id novo"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Métricas do cluster em memória e coleta do Prometheus",
    "output": "doc/diagramas/html/metricas-cluster.html",
    "viewBox": [
      1080,
      480
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "prom",
      "type": "external",
      "label": "Prometheus",
      "sublabel": "alvo único: o balanceador"
    },
    {
      "id": "no",
      "type": "backend",
      "label": "Nó que atende",
      "sublabel": "instantâneo em memória"
    },
    {
      "id": "thread",
      "type": "security",
      "label": "Thread de métricas",
      "sublabel": "em todo nó"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Demais nós",
      "sublabel": "métricas locais"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 242,
      "label": "Atualização periódica"
    },
    {
      "from": 250,
      "to": 306,
      "label": "Coleta"
    }
  ],
  "messages": [
    {
      "id": "refresh",
      "y": 172,
      "from": "thread",
      "to": "demais",
      "label": "GET /cluster/metrics (em paralelo)",
      "variant": "emphasis",
      "note": "a cada refresh-interval"
    },
    {
      "id": "refresh-ok",
      "y": 200,
      "from": "demais",
      "to": "thread",
      "label": "métricas locais de cada nó",
      "variant": "return",
      "note": "sem resposta no prazo: scrape_up = 0"
    },
    {
      "id": "troca",
      "y": 228,
      "from": "thread",
      "to": "no",
      "label": "troca o instantâneo inteiro",
      "variant": "dashed"
    },
    {
      "id": "get",
      "y": 264,
      "from": "prom",
      "to": "no",
      "label": "GET /metrics (balanceador)",
      "variant": "emphasis",
      "note": "qualquer nó atende"
    },
    {
      "id": "resp",
      "y": 292,
      "from": "no",
      "to": "prom",
      "label": "uma série por nó (só lê a memória)",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Sem fan-out no scrape",
      "items": [
        "O /metrics só lê a memória do nó",
        "Rápido mesmo com nós lentos ou fora do ar"
      ]
    },
    {
      "dot": "orange",
      "title": "Nó que não responde",
      "items": [
        "Mantém os últimos valores até max-age",
        "msg_cluster_node_scrape_up vale 0"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sem somar no servidor",
      "items": [
        "Uma série por nó, com o rótulo node",
        "A soma é feita no PromQL"
      ]
    }
  ]
}

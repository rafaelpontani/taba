  "cards": [
    {
      "dot": "emerald",
      "title": "Quórum",
      "items": [
        "Sempre inclui o primário",
        "Resposta sai com o commit confirmado no quórum"
      ]
    },
    {
      "dot": "rose",
      "title": "Falha antes do quórum",
      "items": [
        "Retry (write.retry.*), depois erro ao cliente",
        "Rollback nos nós que já confirmaram"
      ]
    },
    {
      "dot": "orange",
      "title": "Falha depois do quórum",
      "items": [
        "Nunca há rollback",
        "Bloco fica abaixo do fator pleno: evento under-replicated"
      ]
    }

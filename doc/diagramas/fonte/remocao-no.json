{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Removal of a node from the cluster",
    "output": "doc/diagramas/html/remocao-no.html",
    "viewBox": [
      1080,
      646
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "falho",
      "type": "external",
      "label": "Failed node",
      "sublabel": "channel down"
    },
    {
      "id": "detector",
      "type": "backend",
      "label": "Detector node",
      "sublabel": "first to notice"
    },
    {
      "id": "demais",
      "type": "cloud",
      "label": "Other nodes",
      "sublabel": "voters"
    }
  ],
  "segments": [
    {
      "from": 154,
      "to": 218,
      "label": "Detection"
    },
    {
      "from": 232,
      "to": 328,
      "label": "Vote"
    },
    {
      "from": 342,
      "to": 438,
      "label": "Unregistration"
    },
    {
      "from": 452,
      "to": 516,
      "label": "Return"
    }
  ],
  "messages": [
    {
      "id": "sem-sinal",
      "from": "detector",
      "to": "falho",
      "y": 170,
      "label": "heartbeat lost",
      "variant": "dashed"
    },
    {
      "id": "reconecta",
      "from": "detector",
      "to": "falho",
      "y": 202,
      "label": "reconnects N times",
      "variant": "dashed",
      "note": "signals pile up in the queue"
    },
    {
      "id": "voto",
      "from": "detector",
      "to": "demais",
      "y": 248,
      "label": "opens an exclusion vote",
      "variant": "security"
    },
    {
      "id": "votos",
      "from": "demais",
      "to": "detector",
      "y": 280,
      "label": "votes (51% of the healthy)",
      "variant": "return"
    },
    {
      "id": "des",
      "from": "detector",
      "to": "demais",
      "y": 312,
      "label": "unregistration (phase 1)",
      "note": "the lowest ID coordinates; the others wait their turn"
    },
    {
      "id": "des-ok",
      "from": "demais",
      "to": "detector",
      "y": 358,
      "label": "confirm (except the fallen)",
      "variant": "return"
    },
    {
      "id": "des-com",
      "from": "detector",
      "to": "demais",
      "y": 390,
      "label": "commit (phase 2)",
      "variant": "emphasis",
      "note": "discard queues and rebalance"
    },
    {
      "id": "des-fim",
      "from": "demais",
      "to": "detector",
      "y": 422,
      "label": "node removed from the table",
      "variant": "return",
      "note": "the excluded node's freezing goes through the channel"
    },
    {
      "id": "volta",
      "from": "falho",
      "to": "demais",
      "y": 468,
      "label": "queries losses and sends what it finds",
      "variant": "emphasis"
    },
    {
      "id": "rebootstrap",
      "from": "falho",
      "to": "demais",
      "y": 500,
      "label": "clears state and redoes the bootstrap",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Reconnection in time",
      "items": [
        "If the channel comes back before the vote ends, nothing changes"
      ]
    },
    {
      "dot": "rose",
      "title": "Concurrency",
      "items": [
        "During the vote, new bootstraps wait",
        "Two crossing changes: the one with the lowest operationId wins",
        "Optional freezing prevents the node's immediate return"
      ]
    },
    {
      "dot": "emerald",
      "title": "Minimum size",
      "items": [
        "Production: 3 nodes, so there is a voting quorum"
      ]
    }
  ]
}

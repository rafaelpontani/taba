{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "From pull request to release",
    "output": "doc/diagrams/html/ci-cd.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "pr",
      "label": "Branch or pull request (ci.yml)"
    },
    {
      "id": "rel",
      "label": "Push to release or main (release.yml)"
    }
  ],
  "mainPath": [
    "plan",
    "builds",
    "images",
    "tag",
    "publish",
    "float"
  ],
  "nodes": [
    {
      "id": "ci",
      "lane": "pr",
      "col": 0,
      "type": "external",
      "label": "ci.yml",
      "sublabel": "no version",
      "width": 100
    },
    {
      "id": "cibuilds",
      "lane": "pr",
      "col": 1,
      "type": "backend",
      "label": "3 builds",
      "sublabel": "chart, workflow lint",
      "width": 100
    },
    {
      "id": "plan",
      "lane": "rel",
      "col": 0,
      "type": "backend",
      "label": "plan",
      "sublabel": "version (dry-run)",
      "width": 100
    },
    {
      "id": "builds",
      "lane": "rel",
      "col": 1,
      "type": "backend",
      "label": "3 builds",
      "sublabel": "tests, chart",
      "width": 100
    },
    {
      "id": "images",
      "lane": "rel",
      "col": 2,
      "type": "messagebus",
      "label": "images",
      "sublabel": "by digest, signed",
      "width": 100
    },
    {
      "id": "tag",
      "lane": "rel",
      "col": 3,
      "type": "security",
      "label": "tag",
      "sublabel": "draft Release",
      "width": 100
    },
    {
      "id": "publish",
      "lane": "rel",
      "col": 4,
      "type": "messagebus",
      "label": "publish",
      "sublabel": "assets, crates, NuGet",
      "width": 100
    },
    {
      "id": "float",
      "lane": "rel",
      "col": 5,
      "type": "database",
      "label": "tags",
      "sublabel": "on digest, verified",
      "width": 100
    }
  ],
  "edges": [
    {
      "id": "p1",
      "from": "ci",
      "to": "cibuilds",
      "role": "main",
      "label": "calls"
    },
    {
      "id": "r1",
      "from": "plan",
      "to": "builds",
      "role": "main",
      "variant": "emphasis",
      "label": "version"
    },
    {
      "id": "r2",
      "from": "builds",
      "to": "images",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "r3",
      "from": "images",
      "to": "tag",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "r4",
      "from": "tag",
      "to": "publish",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "r5",
      "from": "publish",
      "to": "float",
      "role": "main",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Same workflows",
      "items": [
        "build-server, build-connector-rust and build-connector-csharp are workflow_call",
        "CI and release use the same logic"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing public before green",
      "items": [
        "The tag is created only after builds, tests and images",
        "Every Docker tag is the same digest as the commit"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Telemetry paths",
    "output": "doc/diagrams/html/observability-flow.html",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "On the node"
    },
    {
      "label": "Outputs"
    },
    {
      "label": "Who reads"
    }
  ],
  "nodes": [
    {
      "id": "inst",
      "type": "backend",
      "label": "Instruments",
      "sublabel": "metrics, traces, logs",
      "stage": 0,
      "row": 1
    },
    {
      "id": "peers",
      "type": "backend",
      "label": "Other nodes",
      "sublabel": "state and topic metrics",
      "stage": 0,
      "row": 2
    },
    {
      "id": "otlp",
      "type": "messagebus",
      "label": "OTLP",
      "sublabel": "push, everything",
      "stage": 1,
      "row": 0
    },
    {
      "id": "prom",
      "type": "messagebus",
      "label": "GET /metrics",
      "sublabel": "pull, this node only",
      "stage": 1,
      "row": 1
    },
    {
      "id": "json",
      "type": "frontend",
      "label": "/health/cluster",
      "sublabel": "and /metrics/topics, JSON",
      "stage": 1,
      "row": 2
    },
    {
      "id": "collector",
      "type": "external",
      "label": "OTLP collector",
      "sublabel": "any backend",
      "stage": 2,
      "row": 0
    },
    {
      "id": "prometheus",
      "type": "external",
      "label": "Prometheus",
      "sublabel": "sums the nodes (PromQL)",
      "stage": 2,
      "row": 1
    },
    {
      "id": "operator",
      "type": "external",
      "label": "Operator",
      "sublabel": "CLI and scripts",
      "stage": 2,
      "row": 2
    }
  ],
  "flows": [
    {
      "from": "inst",
      "to": "otlp",
      "label": "same source",
      "variant": "emphasis"
    },
    {
      "from": "inst",
      "to": "prom",
      "label": "pull",
      "route": "straight",
      "labelDx": 30
    },
    {
      "from": "peers",
      "to": "json",
      "label": "queries",
      "variant": "dashed",
      "route": "straight"
    },
    {
      "from": "otlp",
      "to": "collector",
      "label": "all",
      "route": "straight"
    },
    {
      "from": "prom",
      "to": "prometheus",
      "label": "metrics",
      "route": "straight"
    },
    {
      "from": "json",
      "to": "operator",
      "label": "JSON",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "No aggregation on the server",
      "items": [
        "Each node reports its own; the total is the backend's",
        "The exception is the JSON routes, which query the nodes"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Automatic creation of a volatile queue",
    "output": "doc/diagrams/html/volatile-queue-creation.html",
    "viewBox": [
      1080,
      500
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "cons",
      "type": "external",
      "label": "Consumer",
      "sublabel": "client"
    },
    {
      "id": "node",
      "type": "backend",
      "label": "Node that receives the GET",
      "sublabel": "coordinator"
    },
    {
      "id": "all",
      "type": "cloud",
      "label": "All nodes",
      "sublabel": "topic table"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 186,
      "label": "Consumption"
    },
    {
      "from": 194,
      "to": 306,
      "label": "Creation"
    },
    {
      "from": 314,
      "to": 370,
      "label": "Delivery"
    }
  ],
  "messages": [
    {
      "id": "get",
      "from": "cons",
      "to": "node",
      "y": 172,
      "label": "GET messages?autoCreate=true",
      "variant": "security",
      "note": "queue does not exist; counts as a consumer"
    },
    {
      "id": "reg",
      "from": "node",
      "to": "all",
      "y": 208,
      "label": "topic register (phase 1)",
      "note": "id GUID v7, volatile, idleTimeout"
    },
    {
      "id": "ok",
      "from": "all",
      "to": "node",
      "y": 236,
      "label": "all confirm",
      "variant": "return"
    },
    {
      "id": "commit",
      "from": "node",
      "to": "all",
      "y": 264,
      "label": "commit (phase 2)",
      "variant": "emphasis",
      "note": "writes _topics/ and defines the manager"
    },
    {
      "id": "end",
      "from": "all",
      "to": "node",
      "y": 292,
      "label": "queue in the topic table",
      "variant": "return"
    },
    {
      "id": "resp",
      "from": "node",
      "to": "cons",
      "y": 328,
      "label": "message or empty (long polling)",
      "variant": "return"
    },
    {
      "id": "next",
      "from": "cons",
      "to": "node",
      "y": 356,
      "label": "following GETs: the queue already exists",
      "variant": "dashed",
      "note": "creation parameters ignored"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Defaults",
      "items": [
        "Volatile by default (volatile=true)",
        "idleTimeout of 10 min, if not given",
        "Only creates a Queue Topic, never a Distributor"
      ]
    },
    {
      "dot": "orange",
      "title": "Contention",
      "items": [
        "Several consumers create at the same time",
        "The duplicate name is rejected at the register",
        "Whoever loses treats it as an existing queue"
      ]
    },
    {
      "dot": "rose",
      "title": "Errors",
      "items": [
        "Invalid name: 400; Distributor: 409",
        "Volatile queue ceiling reached: 422",
        "Without autoCreate and without a queue: 404"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Scenario 2: local list empty, another node has a message",
    "output": "doc/diagrams/html/consumption-scenario2-other-node.html",
    "viewBox": [
      1080,
      486
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "consumer",
      "type": "external",
      "label": "Consumer",
      "sublabel": "HTTP client"
    },
    {
      "id": "a",
      "type": "backend",
      "label": "Node A",
      "sublabel": "ready list empty"
    },
    {
      "id": "b",
      "type": "security",
      "label": "Node B",
      "sublabel": "primary of m2 and m5"
    },
    {
      "id": "quorum",
      "type": "database",
      "label": "Replicas (quorum)",
      "sublabel": "with primary B"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "y": 176,
      "from": "consumer",
      "to": "a",
      "label": "GET /topics/orders/messages",
      "variant": "emphasis",
      "note": "in-memory table: B and C have messages"
    },
    {
      "id": "m2",
      "y": 214,
      "from": "a",
      "to": "b",
      "label": "take: deliver up to N messages",
      "note": "draws a peer that has some: B"
    },
    {
      "id": "m3",
      "y": 252,
      "from": "b",
      "to": "quorum",
      "label": "invisibility register + commit"
    },
    {
      "id": "m4",
      "y": 290,
      "from": "quorum",
      "to": "b",
      "label": "confirms: quorum closed",
      "variant": "return"
    },
    {
      "id": "m5",
      "y": 328,
      "from": "b",
      "to": "a",
      "label": "message m2",
      "variant": "return"
    },
    {
      "id": "m6",
      "y": 366,
      "from": "a",
      "to": "consumer",
      "label": "200 m2",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "How A knew",
      "items": [
        "When A's list emptied, A sent the \"no ready ones\" signal over the WebSocket",
        "B and C kept this in the in-memory table"
      ]
    },
    {
      "dot": "orange",
      "title": "Stale hint",
      "items": [
        "If B answers empty, A tries another peer, one at a time",
        "Up to delivery.take.max-attempts; then becomes a listener (scenario 3)"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "A new node joining the cluster",
    "output": "doc/diagrams/html/node-join.html",
    "viewBox": [
      1080,
      676
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "new",
      "type": "backend",
      "label": "New node",
      "sublabel": "bootstrap"
    },
    {
      "id": "contact",
      "type": "security",
      "label": "Contact node",
      "sublabel": "via load balancer; coordinates"
    },
    {
      "id": "others",
      "type": "cloud",
      "label": "Other nodes",
      "sublabel": "all the members"
    },
    {
      "id": "resp",
      "type": "database",
      "label": "Block nodes",
      "sublabel": "primary and replicas"
    }
  ],
  "segments": [
    {
      "from": 158,
      "to": 214,
      "label": "Discovery"
    },
    {
      "from": 222,
      "to": 278,
      "label": "Connection test"
    },
    {
      "from": 286,
      "to": 398,
      "label": "Register and commit on all"
    },
    {
      "from": 406,
      "to": 546,
      "label": "Synchronization and readiness"
    }
  ],
  "messages": [
    {
      "id": "list",
      "from": "new",
      "to": "contact",
      "y": 172,
      "label": "GET /cluster/nodes (load balancer)",
      "variant": "dashed",
      "note": "cluster.entry-address"
    },
    {
      "id": "list-ok",
      "from": "contact",
      "to": "new",
      "y": 200,
      "label": "member table (internal IPs)",
      "variant": "return"
    },
    {
      "id": "boot",
      "from": "new",
      "to": "contact",
      "y": 236,
      "label": "join request: IPs and port",
      "variant": "emphasis"
    },
    {
      "id": "test",
      "from": "contact",
      "to": "new",
      "y": 264,
      "label": "tests connection back",
      "note": "if it fails, aborts"
    },
    {
      "id": "reg",
      "from": "contact",
      "to": "others",
      "y": 300,
      "label": "register (phase 1)",
      "note": "on conflict, the older change wins"
    },
    {
      "id": "reg-ok",
      "from": "others",
      "to": "contact",
      "y": 328,
      "label": "all confirm",
      "variant": "return"
    },
    {
      "id": "commit",
      "from": "contact",
      "to": "others",
      "y": 356,
      "label": "commit (phase 2), confirmed by all",
      "variant": "emphasis"
    },
    {
      "id": "table",
      "from": "contact",
      "to": "new",
      "y": 384,
      "label": "node table and nodes in freezing",
      "variant": "return"
    },
    {
      "id": "topics",
      "from": "new",
      "to": "others",
      "y": 420,
      "label": "opens channel and pulls topics (stream)",
      "variant": "dashed",
      "note": "source: lowest-load node"
    },
    {
      "id": "ids",
      "from": "new",
      "to": "resp",
      "y": 448,
      "label": "stream of the block's IDs (union)"
    },
    {
      "id": "get",
      "from": "new",
      "to": "resp",
      "y": 476,
      "label": "GET by range (distributed)",
      "variant": "emphasis"
    },
    {
      "id": "get-ok",
      "from": "resp",
      "to": "new",
      "y": 504,
      "label": "messages (NDJSON) straight to disk",
      "variant": "return"
    },
    {
      "id": "final",
      "from": "new",
      "to": "resp",
      "y": 532,
      "label": "final check: relists IDs",
      "variant": "dashed",
      "note": "then processes the event database and becomes ready"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Failure before the commit",
      "items": [
        "Register rollback and the new node is excluded",
        "Conflict with another change: the loser restarts in 100 to 200 ms",
        "Blocks are rebalanced without it"
      ]
    },
    {
      "dot": "orange",
      "title": "Failure in the commit",
      "items": [
        "No rollback: insists until write.commit.timeout"
      ]
    },
    {
      "dot": "emerald",
      "title": "During the synchronization",
      "items": [
        "Events that arrive go to the event database (SQLite)",
        "At the end, processed row by row; it empties and the node becomes ready",
        "Until then, client calls are forwarded to another node"
      ]
    }
  ]
}

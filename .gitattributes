# Os vetores de referência do formato entre nós são comparados byte a byte: sempre LF, também num clone do
# Windows com core.autocrlf.
crates/taba-node/tests/wire/*.hex text eol=lf
# O SDK e o schema gerados do provider Pulumi: sempre LF, para o teste "sdks" comparar byte a byte no Windows também.
connectors/pulumi/sdk/** text eol=lf
connectors/pulumi/sdk/**/*.png binary
connectors/pulumi/provider/cmd/pulumi-resource-taba/*.json text eol=lf
# Fontes Go: sempre LF, para o `gofmt -l` dos scripts de teste (que rodam num container Linux) passar também num
# clone do Windows com core.autocrlf (PRB-113).
*.go text eol=lf
# Documentação e exemplos do provider Terraform: sempre LF. O `go generate` os compara byte a byte e o provider Pulumi
# lê a documentação para converter os exemplos; com CRLF o exemplo do token era descartado (PRB-113, KI-038).
connectors/terraform/docs/** text eol=lf
connectors/terraform/examples/** text eol=lf
# Scripts de shell: sempre LF. Os testes os executam dentro de containers Linux (`sh /repo/...`), e com CRLF num clone
# do Windows com core.autocrlf o `sh` lê `$'\r'` no fim de cada linha (PRB-113, KI-040).
*.sh text eol=lf

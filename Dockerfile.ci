# syntax=docker/dockerfile:1
#
# The node image used by the pipeline (.github/workflows). It compiles nothing: the `taba` binary already comes
# ready in dist/taba-<arch>, built by the .github/actions/node-binary action with the runner's cache. buildx
# (amd64 and arm64 platforms) picks the file by TARGETARCH. This way the image build takes seconds,
# instead of recompiling Rust inside the container on every commit.
#
# For users who download the repository, use the root Dockerfile (`docker build -t taba .`): it
# compiles everything by itself and produces the same image.

FROM alpine:3
ARG TARGETARCH
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 taba \
 && mkdir -p /var/lib/taba /etc/taba/secrets \
 && chown taba:taba /var/lib/taba
COPY dist/taba-${TARGETARCH} /usr/local/bin/taba
# Unprivileged. The node data (storage.dir) and the secrets folder (secrets.dir) are volumes.
USER taba
VOLUME ["/var/lib/taba"]
EXPOSE 8080 8081 9090
ENTRYPOINT ["taba"]
